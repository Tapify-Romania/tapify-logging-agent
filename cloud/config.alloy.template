local.file "grafana_token" {
  filename  = sys.env("CREDENTIALS_DIRECTORY") + "/grafana_token"
  is_secret = true
}

prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "stat", "textfile", "time", "uname", "vmstat"]
  textfile {
    directory = "/var/lib/tapify-observability-metrics"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "30s"
  job_name        = "tapify-host"
  forward_to      = [prometheus.relabel.production.receiver]
}

// @@BEGIN_PROD_ONLY@@
// Tapify API metrics (KAN-159). The API publishes them on host loopback only
// (127.0.0.1:9464); this collector pushes them with the existing credentials.
prometheus.scrape "api" {
  targets         = [{"__address__" = "127.0.0.1:9464"}]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  job_name        = "tapify-api"
  forward_to      = [prometheus.relabel.api.receiver]
}

prometheus.relabel "api" {
  forward_to = [prometheus.remote_write.cloud.receiver]
  rule {
    target_label = "host"
    replacement  = @@HOST@@
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
}
// @@END_PROD_ONLY@@

prometheus.relabel "production" {
  forward_to = [prometheus.remote_write.cloud.receiver]
  rule {
    target_label = "job"
    replacement  = "tapify-host"
  }
  rule {
    target_label = "host"
    replacement  = @@HOST@@
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = @@METRICS_URL@@
    basic_auth {
      username = @@METRICS_USERNAME@@
      password = local.file.grafana_token.content
    }
  }
}

loki.source.file "sanitized_events" {
  targets = [{__path__ = "/var/log/tapify-observability/events.log", host = @@HOST@@, environment = "production", job = "tapify-observability"}]
  forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
  endpoint {
    url = @@LOGS_URL@@
    basic_auth {
      username = @@LOGS_USERNAME@@
      password = local.file.grafana_token.content
    }
  }
}
